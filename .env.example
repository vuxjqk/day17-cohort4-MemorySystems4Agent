# offline (default, deterministic) | live (LangChain agent with a real LLM)
LAB_MODE=offline

# openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Optional judge model (defaults to the main provider/model)
JUDGE_PROVIDER=
JUDGE_MODEL=

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Memory knobs
COMPACT_THRESHOLD_TOKENS=1000
COMPACT_KEEP_MESSAGES=4
PROFILE_CONFIDENCE_THRESHOLD=0.6
